{
  "name": "horaspay",
  "version": "0.1.0",
  "private": true,
  "description": "HorasPay: control de jornadas y pagos para Windows.",
  "author": "HorasPay",
  "main": "dist-electron/main.js",
  "scripts": {
    "web:dev": "ng serve --configuration development --host 127.0.0.1",
    "web:build": "ng build --configuration production",
    "api:dev": "dotnet run --project src/HorasPay.Api -- --urls http://127.0.0.1:5157",
    "electron:build": "tsc -p electron/tsconfig.json",
    "desktop:dev": "concurrently -k \"npm run api:dev\" \"npm run web:dev\" \"wait-on http-get://127.0.0.1:4200 http-get://127.0.0.1:5157/health && npm run electron:build && cross-env HORASPAY_DEV_URL=http://127.0.0.1:4200 electron .\"",
    "test": "jasmine --config=frontend/jasmine.json",
    "test:e2e": "playwright test",
    "build": "npm run web:build && npm run electron:build",
    "publish:api": "cross-env DOTNET_CLI_HOME=.dotnet-cli NUGET_PACKAGES=.nuget/packages dotnet publish src/HorasPay.Api -c Release -r win-x64 --self-contained -o dist-api --no-restore",
    "release": "npm run web:build && npm run publish:api && npm run electron:build && electron-builder --win nsis portable && node scripts/checksums.mjs && node scripts/publish-release.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "chart.js": "4.5.1",
    "ng2-charts": "8.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.34",
    "@angular/cli": "20.3.42",
    "@angular/compiler-cli": "20.3.34",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.0",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-updater": "6.6.2",
    "jasmine": "5.10.0",
    "typescript": "5.9.3",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "com.horaspay.app",
    "productName": "HorasPay",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["dist/frontend/browser/**", "dist-electron/**", "package.json"],
    "extraResources": [{ "from": "dist-api", "to": "api" }],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "${productName}-Setup-${version}.${ext}", "oneClick": true, "perMachine": false, "allowToChangeInstallationDirectory": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "runAfterFinish": true, "installerLanguages": ["es_ES"] },
    "portable": { "artifactName": "${productName}-Portable-${version}.${ext}" },
    "publish": [{ "provider": "github", "owner": "trk-cod", "repo": "HorasPay" }]
  }
}
